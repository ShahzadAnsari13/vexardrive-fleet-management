<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.manager.ManagerActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/managerNavHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/manager_nav_graph" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/managerBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@android:color/white"
        app:itemIconTint="@color/manager_bottom_nav_color"
        app:itemTextColor="@color/manager_bottom_nav_color"
        app:itemActiveIndicatorStyle="@style/ManagerBottomNavIndicator"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/manager_bottom_nav_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>